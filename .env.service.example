# Gere uma chave aleatória longa e compartilhe-a somente com o consumidor.
MS_PESO_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

MS_PESO_HOST=127.0.0.1
MS_PESO_PORT=8080
MS_PESO_DEVICE=auto
MS_PESO_PACKAGE_PATH=models/commercial_candidate.yaml
MS_PESO_MAX_UPLOAD_BYTES=10485760

# Segurança: mantenha false. true serve somente para validar o contrato HTTP em
# ambiente interno, nunca para disponibilizar o candidato como produto.
MS_PESO_ALLOW_UNAPPROVED_CANDIDATE=false
